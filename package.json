{
    "name": "aplayer",
    "version": "2.0.0",
    "description": "玻璃拟态悬浮音乐播放器（Vue 3）：拖拽、缩放、自动折叠、桌面歌词，与站点主题令牌无缝融合",
    "main": "dist/APlayer.min.js",
    "style": "dist/APlayer.min.css",
    "license": "MIT",
    "scripts": {
        "build": "node build.mjs --production",
        "dev": "node build.mjs",
        "test": "node scripts/dom-test.mjs",
        "format": "prettier --write \"**/*.{js,mjs,json,md,html,css}\"",
        "format:check": "prettier --check \"**/*.{js,mjs,json,md,html,css}\""
    },
    "files": [
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Xinyang-Gao/APlayer.git"
    },
    "keywords": [
        "player",
        "music",
        "html5",
        "vue",
        "glassmorphism",
        "draggable",
        "lyrics"
    ],
    "author": "Xinyang-Gao",
    "devDependencies": {
        "esbuild": "^0.24.2",
        "prettier": "^3.4.2",
        "vue": "^3.5.13"
    },
    "optionalDependencies": {
        "linkedom": "^0.18.14"
    }
}
